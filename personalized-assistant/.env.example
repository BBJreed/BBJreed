# --- Database ---
# SQLite is fine for local dev. Point this at Postgres in production.
DATABASE_URL="file:./dev.db"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth providers (sign-in + "Connections" account linking) ---
# Leave a pair blank to disable that provider — the app checks for these
# at startup and only shows sign-in buttons for providers that are configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Assistant (Claude) ---
# Required for the /assistant chat to actually respond.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Not wired up yet (see README "What's actually working") ---
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"
